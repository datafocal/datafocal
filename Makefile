GO      ?= go
OUT     ?= ./.localdata
SCENARIO ?= all

ADDR    ?= :8080

.PHONY: build test race lint bench fmt fmt-check vet check seed serve clean-seed rcabench semgrep web web-check web-types web-fixtures view-fixtures web-preview web-browser web-browser-run preview preview-check image definitions-image deploy-kind undeploy-kind install-local install-local-kind uninstall-local e2e bench-e2e bench-corpora bench-compare bench-query bench-fleet

build:
	$(GO) build ./...

## web: build the UI into web/dist, which the querier embeds and serves at /ui/.
## corepack runs the pnpm web/package.json pins, so only Node needs installing.
export COREPACK_ENABLE_DOWNLOAD_PROMPT = 0
web: web-fixtures
	cd web && corepack pnpm install --frozen-lockfile && corepack pnpm build

## preview: screenshots for a PR, PREVIEW_PAGES (every view unset) in and a PNG per page
## in PREVIEW_OUT, each view's scenario answered from its fixtures: dark, as tall as
## the page, and shot once every panel has loaded.
preview: web
	node web/preview/shoot.ts

## preview-check: make preview shoots every view populated, and fails on a broken page;
## scripts/web-preview-check.sh DIR reads the views make preview already wrote to DIR.
preview-check: web
	./scripts/web-preview-check.sh

## web-preview: build the UI into web/dist answering from the fixtures, so it runs as
## static files with no querier.
web-preview: web-fixtures
	$(WEB_PNPM) install --frozen-lockfile
	$(WEB_PNPM) exec tsc -b
	$(WEB_PNPM) exec vite build --mode fixtures && touch dist/.gitkeep

## web-types: generate @datafocal/api's types from the Go request and response structs.
web-types:
	$(GO) run github.com/gzuidhof/tygo@v0.2.21 generate

## web-fixtures: copy the tool goldens (regenerated by go test ./internal/e2e -run
## TestToolGoldens -update) and the request rules (-run TestRequestRules -update) into
## @datafocal/api, which serves them in tests and the fixtures build, and write the view fixtures.
web-fixtures: view-fixtures
	mkdir -p web/packages/api/fixtures
	cp internal/query/tools/testdata/*.golden.json internal/query/tools/testdata/request_rules.json web/packages/api/fixtures/

## view-fixtures: write the engine's answer to each request a view lists in requests.json into
## its git-ignored fixtures/, which its tests and make preview read; -count=1 as a cached run writes nothing.
view-fixtures:
	$(GO) test ./internal/e2e -run '^TestViewFixtures$$' -count=1 -update

## web-check: the frontend gate: formatting, lint, types, package boundaries, unused code,
## suppressions, Go↔TS drift, unit tests, the bundle budget and the colour-token check over
## the stylesheets. WEB_GATE_FIXTURES=0 skips the lint rules' self-test, as pr.yml does when the
## diff leaves the rules, their fixtures and the linters alone.
WEB_PNPM = cd web && corepack pnpm
WEB_GATE_FIXTURES ?= 1
web-check: web-fixtures web-types
	git diff --exit-code -- web/packages/api/src/generated
	$(WEB_PNPM) install --frozen-lockfile
	$(WEB_PNPM) exec biome ci
	$(WEB_PNPM) exec oxlint --type-aware --deny-warnings packages
	./scripts/web-suppressions.sh
	$(GO) test -run TestCSSUsesTokens ./web
	$(WEB_PNPM) exec tsc -b
	$(WEB_PNPM) exec depcruise packages
	$(WEB_PNPM) exec knip
	$(WEB_PNPM) exec vitest run --project unit
	$(WEB_PNPM) build
	$(WEB_PNPM) exec size-limit
	[ "$(WEB_GATE_FIXTURES)" = 0 ] || ./scripts/web-gate-fixtures.sh

## web-browser: the component tests in Chromium (§9, step 10) when the diff touches web/.
## The performance budgets run by hand: playwright test perf/pr, too costly for CI.
web-browser:
	@changed=$$(git diff --name-only $(BASE)) || exit 1; \
	if echo "$$changed" | grep -q '^web/'; then $(MAKE) web-browser-run; fi

web-browser-run: web-fixtures
	$(WEB_PNPM) install --frozen-lockfile
	$(WEB_PNPM) exec vitest run --project browser

## image: build the collector, querier and compactor container images.
image: web
	docker build --build-arg CMD=collector -t datafocal-collector:dev -f build/Dockerfile .
	docker build --build-arg CMD=querier -t datafocal-querier:dev -f build/Dockerfile .
	docker build --build-arg CMD=compactor -t datafocal-compactor:dev -f build/Dockerfile .

## definitions-image: the SLO definitions in DEFS as an image FROM busybox, with the files at
## /definitions, tagged by their content's hash, for the querier's image volume.
DEFS ?= deploy/definitions
DEFS_TAG = $(shell cd $(DEFS) && find . -type f | LC_ALL=C sort | xargs sha256sum | sha256sum | cut -c1-12)
definitions-image:
	printf 'FROM busybox:1.37\nCOPY . /definitions\n' | docker build -t datafocal-definitions:$(DEFS_TAG) -f - $(DEFS)

## deploy-kind: run MinIO, the collector and cAdvisor DaemonSets, the cluster-events collector,
## the querier and the compactor on
## a kind cluster, creating the cluster if it does not exist, the querier reading the definitions
## in DEFS.
KIND_CLUSTER ?= datafocal
KUBECTL = kubectl --context kind-$(KIND_CLUSTER) -n datafocal
deploy-kind: image definitions-image
	kind get clusters | grep -qx $(KIND_CLUSTER) || kind create cluster --name $(KIND_CLUSTER) --config deploy/kind/cluster.yaml
	kind load docker-image --name $(KIND_CLUSTER) datafocal-collector:dev datafocal-querier:dev datafocal-compactor:dev datafocal-definitions:$(DEFS_TAG)
	# The manifests name the definitions image datafocal-definitions:sample, whose tag no
	# kustomize transformer reaches in an image volume.
	kubectl kustomize deploy/k8s/kind | sed 's|datafocal-definitions:sample|datafocal-definitions:$(DEFS_TAG)|' | $(KUBECTL) apply -f -
	$(KUBECTL) wait --for=condition=complete job/create-bucket --timeout=5m
	# The images keep their :dev tag, so apply sees no change; restart onto the ones just loaded.
	$(KUBECTL) rollout restart daemonset/collector deployment/querier deployment/compactor
	$(KUBECTL) rollout status deployment/minio --timeout=5m
	$(KUBECTL) rollout status daemonset/collector --timeout=5m
	$(KUBECTL) rollout status daemonset/cadvisor --timeout=5m
	$(KUBECTL) rollout status deployment/querier --timeout=5m
	$(KUBECTL) rollout status deployment/compactor --timeout=5m

undeploy-kind:
	$(KUBECTL) delete -k deploy/k8s/kind --ignore-not-found

## install-local: the collector, querier and compactor as systemd user services, over a MinIO
## container on localhost:9000, the UI at localhost:8080/ui/. install-local-kind deploys this
## checkout to the kind cluster, then runs only the collector here, writing to the cluster's
## MinIO, so its one compactor and querier serve both. uninstall-local removes either, keeping
## the data (scripts/install-local.sh). CLAUDE_QUOTA=1 also sets Claude Code's status line to
## one that logs the account's quota.
install-local: web
	GO=$(GO) CLAUDE_QUOTA=$(CLAUDE_QUOTA) ./scripts/install-local.sh standalone

install-local-kind: deploy-kind
	GO=$(GO) KIND_CLUSTER=$(KIND_CLUSTER) CLAUDE_QUOTA=$(CLAUDE_QUOTA) ./scripts/install-local.sh kind

uninstall-local:
	./scripts/install-local.sh uninstall

# test includes the alloc-budget and cost-model regression gates
# (they are ordinary tests); race is the fuller pre-merge run.
test:
	$(GO) test ./...

## race: the corpus suites run without -race, which made them ~6x slower and the gate's critical path.
race:
	$(GO) test -race $$($(GO) list ./... | grep -vE '/internal/(e2e|query/tools|seedcorpus)$$')
	$(GO) test ./internal/e2e ./internal/query/tools ./internal/seedcorpus

## lint: complexity + dependency-allowlist gate.
## Requires a golangci-lint built with the active Go toolchain.
lint:
	golangci-lint run ./...

## bench: run the hot-path micro-benchmarks (baseline for the benchstat gate).
bench:
	$(GO) test -bench=. -benchmem -run='^$$' ./...

## e2e: the stack suite — seeded log files through the collector and querier binaries
## against MinIO in docker (internal/e2e/stack). Needs docker; not part of test.
e2e:
	$(GO) test -tags stack -count=1 -timeout 30m ./internal/e2e/stack/

## bench-e2e: ingest COPIES hour-apart copies of the seeded corpus (~60 MB each) through
## the stack and write throughput, footprint, query latency and each phase's time to
## $(OUT)/bench-$(COPIES).json, or REPORT.
## To iterate: NODES=K collectors write the same hours; REPS sets the warm repetitions;
## PHASES picks from ingest,compact,query; PERSIST=1 keeps MinIO
## running and BUCKET names the bucket, so a later PHASES=query run reuses what one left;
## LOGCACHE=dir keeps generated logs for a later run of the same copies, nodes and hour.
## CORPUS=dir replays a captured corpus (scripts/capture-corpus.sh) in place of the seeded one,
## COPIES times back to back, and asks it what its views ask (internal/e2e/stack/flows_test.go).
COPIES ?= 5
NODES ?= 1
REPS ?= 10
PHASES ?= ingest,compact,query
REPORT ?= $(OUT)/bench-$(COPIES).json
## CPUS=n and MEMORY_MB=n hold DataFocal to those cores and memory, so timings are per node
## of that size; unset, it has the whole host.
LIMITS = $(if $(CPUS),-stack.cpus=$(CPUS)) $(if $(MEMORY_MB),-stack.memory_mb=$(MEMORY_MB))
## BENCH_CORES (0-3 unless set) are the host cores the run, and everything it starts but MinIO
## (2 cores), may use, at low priority, so the rest of the host stays usable.
BENCH_CORES ?= 0-3
bench-e2e:
	mkdir -p $(OUT)
	nice -n 10 taskset -c $(BENCH_CORES) $(GO) test -tags stack -count=1 -run TestBenchmark -timeout 60m -v ./internal/e2e/stack/ \
		-stack.copies=$(COPIES) -stack.nodes=$(NODES) -stack.reps=$(REPS) -stack.phases=$(PHASES) \
		-stack.out=$(abspath $(REPORT)) \
		$(if $(PERSIST),-stack.persist) $(LIMITS) \
		$(if $(TENANT),-stack.tenant=$(TENANT)) \
		$(if $(BUCKET),-stack.bucket=$(BUCKET)) $(if $(LOGCACHE),-stack.logcache=$(abspath $(LOGCACHE))) \
		$(if $(CORPUS),-stack.corpus=$(abspath $(CORPUS))) $(if $(INGESTCACHE),-stack.ingestcache=$(abspath $(INGESTCACHE)))

## bench-corpora: bench-e2e over each captured corpus in CORPORA, held to the deployed querier's
## pod (CPUS=1, MEMORY_MB=3072 unless set), each its manifest's copies unless CORPUS_COPIES is set,
## into $(OUT)/scorecard-<name>.json and .md;
## BASELINE=dir of earlier scorecard-<name>.json also writes each one's .vs-<baseline> comparison.
## Replays are kept under LOGCACHE (.localdata/replays unless set), so a baseline and its
## comparison read the same bytes, and ingested buckets under INGESTCACHE (.localdata/ingests
## unless set) by the collector's and compactor's code, so a querier-only change skips ingest.
## CORPORA is empty on a fresh clone: scripts/capture-corpus.sh fills .localdata/corpus.
CORPORA ?= $(wildcard .localdata/corpus/*)
bench-corpora:
	@for c in $(CORPORA); do name=$$(jq -r .name $$c/manifest.json); \
	  $(MAKE) bench-e2e CORPUS=$$c COPIES=$(or $(CORPUS_COPIES),0) CPUS=$(or $(CPUS),1) MEMORY_MB=$(or $(MEMORY_MB),3072) \
	    LOGCACHE=$(or $(LOGCACHE),$(abspath .localdata/replays)) INGESTCACHE=$(or $(INGESTCACHE),$(abspath .localdata/ingests)) \
	    REPORT=$(abspath $(OUT))/scorecard-$$name.json || exit 1; \
	  $(GO) test -count=1 -run '^TestScorecard$$' ./internal/e2e/stack/ -scorecard=$(abspath $(OUT))/scorecard-$$name.json \
	    $(if $(BASELINE),-baseline=$(abspath $(BASELINE))/scorecard-$$name.json) || exit 1; \
	done

## bench-compare: bench-corpora at BENCH_BASE (main unless set), checked out under .localdata/bench-base,
## and at this checkout side by side, on BENCH_CORES_BASE and BENCH_CORES_HEAD (0-3 and 4-7
## unless set, so eight cores) with their own caches, then this
## checkout's scorecards compared with BENCH_BASE's; under ten minutes when neither changed ingest.
## BASE_LOGCACHE (.localdata/replays-base unless set) keeps BENCH_BASE's replays apart from LOGCACHE's,
## since the two runs would write a first replay at once.
BENCH_BASE ?= main
BENCH_CORES_BASE ?= 0-3
BENCH_CORES_HEAD ?= 4-7
BASE_LOGCACHE ?= $(abspath .localdata/replays-base)
bench-compare:
	git worktree remove --force .localdata/bench-base 2>/dev/null; git worktree add --detach .localdata/bench-base $(BENCH_BASE)
	@corpora="$(abspath $(CORPORA))"; \
	$(MAKE) -C .localdata/bench-base bench-corpora CORPORA="$$corpora" BENCH_CORES=$(BENCH_CORES_BASE) OUT=$(abspath .localdata/bench-base/.localdata) \
	  LOGCACHE=$(abspath $(BASE_LOGCACHE)) INGESTCACHE=$(abspath $(or $(INGESTCACHE),.localdata/ingests)) >.localdata/bench-base.log 2>&1 & base=$$!; \
	$(MAKE) bench-corpora CORPORA="$$corpora" BENCH_CORES=$(BENCH_CORES_HEAD) >.localdata/bench-head.log 2>&1; head=$$?; \
	wait $$base || { tail -n 30 .localdata/bench-base.log; exit 1; }; [ $$head = 0 ] || { tail -n 30 .localdata/bench-head.log; exit 1; }; \
	for c in $$corpora; do name=$$(jq -r .name $$c/manifest.json); \
	  $(GO) test -count=1 -run '^TestScorecard$$' ./internal/e2e/stack/ -scorecard=$(abspath $(OUT))/scorecard-$$name.json \
	    -baseline=$(abspath .localdata/bench-base/.localdata)/scorecard-$$name.json || exit 1; \
	done

## bench-fleet: NODES (300 unless set) simulated collectors in one process, each writing RATE lines a second
## and cutting every INTERVAL (the collector's default, 1m, unless set) over HOURS of
## simulated time into one bucket beside the compactor, then the querier in-process over
## what they wrote: commits and their conflicts, compaction, the catalog, the querier's
## catalog load and summary build, and the query archetypes, to $(OUT)/fleet-<nodes>.json,
## or FLEET_REPORT; PERSIST=1 keeps MinIO running.
RATE ?= 5
HOURS ?= 2
FLEET_NODES = $(if $(filter command line,$(origin NODES)),$(NODES),300)
FLEET_REPORT ?= $(OUT)/fleet-$(FLEET_NODES).json
bench-fleet:
	mkdir -p $(OUT)
	$(GO) test -tags stack -count=1 -run '^TestFleet$$' -timeout 120m -v ./internal/e2e/stack/ \
		-stack.fleet=$(FLEET_NODES) -stack.rate=$(RATE) $(if $(INTERVAL),-stack.interval=$(INTERVAL)) -stack.hours=$(HOURS) \
		-stack.reps=$(REPS) -stack.out=$(abspath $(FLEET_REPORT)) \
		$(if $(PERSIST),-stack.persist) $(LIMITS)

## bench-query: the query archetypes in-process over COPIES copies on the fs store, no
## docker: the inner loop for read-path work, bench-e2e the check after it.
bench-query:
	$(GO) test -run '^$$' -bench BenchmarkQuery -benchtime 10x ./internal/e2e/ -query.copies=$(COPIES)

## semgrep: semantic style rules (sleeps in tests, struct-dump logging,
## fatal-exit outside main). Mandatory — install with: pip3 install --user semgrep
semgrep:
	@command -v semgrep >/dev/null || { echo "semgrep not found: pip3 install --user semgrep"; exit 1; }
	semgrep scan --quiet --error --config scripts/semgrep-style.yml .

## check: the full local pre-merge gate, plus web-check when the diff touches a path in
## WEB_GATED, compared with BASE (origin/main unless set). A BASE that does not resolve fails
## here instead of skipping the frontend gate.
BASE ?= origin/main
WEB_GATED = ^(web/|tygo\.yaml$$|internal/|deploy/definitions/|go\.(mod|sum)$$|Makefile$$|scripts/web-)
check: fmt-check vet lint semgrep race
	@changed=$$(git diff --name-only $(BASE)) || exit 1; \
	if echo "$$changed" | grep -qE '$(WEB_GATED)'; then $(MAKE) web-check; fi

fmt:
	gofmt -w .

fmt-check:
	@out=$$(gofmt -l .); [ -z "$$out" ] || { echo "gofmt needed on:"; echo "$$out"; exit 1; }

## vet also vets the stack suite, which no test run compiles.
vet:
	$(GO) vet ./...
	$(GO) vet -tags stack ./internal/e2e/stack/

## seed: generate the real corpus under $(OUT)
seed:
	$(GO) run ./cmd/datafocal-seed --out $(OUT) --scenario $(SCENARIO)

## serve: run the querier against the seeded corpus in $(OUT)
serve:
	$(GO) run ./cmd/querier --root $(OUT) --addr $(ADDR)

clean-seed:
	rm -rf $(OUT)

## rcabench: regenerate the committed scorecard in internal/rcabench/testdata.
## Run after any change that may affect RCA quality; CI fails on an un-committed delta.
rcabench:
	$(GO) test ./internal/rcabench -run TestScorecard -rcabench.update -timeout 300s

