# What the local collector, querier and compactor share: the kind deployment's settings
# (deploy/k8s/base, deploy/k8s/kind), so a collector here and one in kind write one bucket.
# Both modes serve MinIO on localhost:9000, with the kind deployment's development keys.
DATAFOCAL_STORE=s3
DATAFOCAL_S3_ENDPOINT=127.0.0.1:9000
DATAFOCAL_S3_BUCKET=datafocal
DATAFOCAL_FLUSH_INTERVAL=10s
DATAFOCAL_FLUSH_ALIGNMENT=1h
AWS_ACCESS_KEY_ID=datafocal
AWS_SECRET_ACCESS_KEY=datafocal-dev-secret
# The SLO definitions the querier reads and saves, created by install-local.sh, which spells
# out the home directory, since systemd expands no variables.
DATAFOCAL_DEFINITIONS_DIR=$HOME/.config/datafocal/definitions
